API_PROXY_URL=http://localhost:8787
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Used by Drizzle Kit from apps/api.
DATABASE_URL=

# API Worker configuration (set secrets in Cloudflare for production).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8787
WEB_APP_URL=http://localhost:3000
