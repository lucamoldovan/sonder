# Copy to .env.local for local Next.js development.
# Use Supabase's direct connection string, or the session pooler if your
# local network does not support IPv6. Never commit the real value.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
WEB_APP_URL=http://localhost:3000
ENVIRONMENT=development
# Optional free Google OAuth (leave blank to hide the Google sign-in button).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false
