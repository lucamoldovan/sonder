{
  "name": "sonder",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:web": "next dev",
    "dev:api": "bun --cwd apps/api run dev",
    "dev:mobile": "bun --cwd apps/mobile run start",
    "dev:all": "turbo run dev --parallel",
    "build": "next build",
    "build:all": "turbo run build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "turbo run typecheck",
    "test": "bun test"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.5.0",
    "turbo": "^2.5.6",
    "typescript": "^5.8.3"
  }
}