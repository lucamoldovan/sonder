{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sonder-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "BETTER_AUTH_URL": "http://localhost:8787",
    "WEB_APP_URL": "http://localhost:3000",
    "ENVIRONMENT": "development"
  },
  "observability": {
    "enabled": true
  }
}