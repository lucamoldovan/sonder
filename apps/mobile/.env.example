# API URL reachable from the phone/emulator.
# Android emulator: http://10.0.2.2:3000
# iOS simulator: http://localhost:3000
# Physical device during local development: http://YOUR_COMPUTER_LAN_IP:3000
# Production: your Cloudflare Worker URL, e.g. https://sonder.YOUR-SUBDOMAIN.workers.dev
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_GOOGLE_OAUTH_ENABLED=false
